# Relais HTTPS de Beyassa, derrière Cloudflare (mode SSL/TLS « Full (strict) »).
#
# Fichier modèle : au démarrage du conteneur, l'image nginx remplace ${DOMAINE} par la
# variable DOMAINE du .env et écrit le résultat dans /etc/nginx/conf.d/default.conf.
# Seule DOMAINE est remplacée (NGINX_ENVSUBST_FILTER) : les variables nginx ($host...) restent.

server_tokens off;

# --- Vraie adresse du visiteur ----------------------------------------------------------------
# Le serveur ne voit que Cloudflare ; Cloudflare transmet l'adresse du visiteur dans l'en-tête
# CF-Connecting-IP. On ne croit cet en-tête que s'il arrive d'une adresse Cloudflare : sinon
# n'importe qui pourrait se faire passer pour une autre adresse et contourner les limites.
include /etc/nginx/cloudflare/realip.conf;
real_ip_header CF-Connecting-IP;

# --- Seul Cloudflare peut joindre le serveur ----------------------------------------------------
# $realip_remote_addr est l'adresse de la connexion elle-même (avant le remplacement ci-dessus).
# Docker publie ses ports en contournant le pare-feu du système (ufw) : le filtrage se fait donc ici.
geo $realip_remote_addr $via_cloudflare {
    default 0;
    include /etc/nginx/cloudflare/geo.conf;
}

# Résolveur interne de Docker : l'adresse du conteneur « web » est relue toutes les 10 s.
# Sans cela, nginx la garde en mémoire et un « web » recréé rendrait le relais sourd.
resolver 127.0.0.11 valid=10s ipv6=off;

# Connexion qui ne demande pas le bon nom (scan direct de l'IP, autre domaine) : refusée d'emblée.
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAINE};

    # Certificat d'origine Cloudflare : il ne sert qu'à la liaison Cloudflare -> serveur.
    # Les navigateurs, eux, voient le certificat public de Cloudflare.
    ssl_certificate     /etc/nginx/certs/origine.pem;
    ssl_certificate_key /etc/nginx/certs/origine.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    if ($via_cloudflare = 0) {
        return 444;  # connexion fermée sans réponse
    }

    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 1m;

    # L'application fait confiance à un seul relais (ProxyFix, x_for=1) : on remplace
    # X-Forwarded-For par l'adresse réelle au lieu de l'allonger.
    set $application http://web:8000;
    proxy_set_header Host              $host;
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host  $host;

    # Le jeton du QR code ne doit apparaître dans aucun journal.
    location /acces/ {
        access_log off;
        proxy_pass $application;
    }

    location / {
        proxy_pass $application;
    }
}
