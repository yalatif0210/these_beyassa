# Copier ce fichier en .env et remplir les valeurs.

# Clé secrète Flask : une longue chaîne aléatoire.
# Pour en générer une : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a_remplacer

# Nom de domaine servi par le relais nginx (sans https://)
DOMAINE=etude.beyassa.org

# Adresse publique de l'application (sert à construire le lien du QR code)
BASE_URL=https://etude.beyassa.org

# Compte administrateur créé au premier démarrage (changer le mot de passe ensuite dans l'application)
ADMIN_IDENTIFIANT=nguessan
ADMIN_MOT_DE_PASSE=a_remplacer

# Nom affiché en haut des pages et sur l'affiche du QR code
NOM_ETUDE=Étude hydrocèle de l'enfant

# Base PostgreSQL (docker-compose)
POSTGRES_DB=beyassa
POSTGRES_USER=beyassa
POSTGRES_PASSWORD=a_remplacer

# Nombre de jours de conservation des sauvegardes
CONSERVATION_JOURS=30
